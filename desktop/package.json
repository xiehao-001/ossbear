{
  "name": "storagebear",
  "productName": "存储熊",
  "version": "0.1.10",
  "description": "把火山、阿里、腾讯、华为等对象存储变成一块好用的虚拟磁盘",
  "main": "src/main.js",
  "author": "StorageBear",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "SB_DEV=1 electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.storagebear.desktop",
    "productName": "存储熊",
    "copyright": "StorageBear",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xiehao-001",
        "repo": "ossbear-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StorageBear-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "存储熊",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "StorageBear-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    }
  }
}
